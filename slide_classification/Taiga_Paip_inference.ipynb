   "source": [
    "# ============================================================\\n",
    "# CELL 7 — Prediction Function\\n",
    "# ============================================================\\n",
    "def predict(classifier_name: str, model, feat: torch.Tensor):\\n",
    "    '''\\n",
    "    Run inference for a single sample.\\n",
    "    Returns (pred: int, proba: np.ndarray shape (2,) or None)\\n",
    "    '''\\n",
    "    if classifier_name == 'ann':\\n",
    "        x = feat.unsqueeze(0) if feat.dim() == 1 else feat\\n",
    "        with torch.no_grad():\\n",
    "            out = model(x)\\n",
    "            # Model already has Softmax, so out is already probabilities\\n",
    "            proba = out.numpy()[0]\\n",
    "            pred = int(out.argmax(dim=1).item())\\n",
    "        return pred, proba\\n",
    "    elif classifier_name == 'protonet' and isinstance(model, dict):\\n",
    "        # Handle protonet models saved as dicts with prototypes\\n",
    "        if 'prototypes' in model and 'labels_proto' in model:\\n",
    "            prototypes = model['prototypes']  # Shape: (n_prototypes, feature_dim)\\n",
    "            labels_proto = model['labels_proto']  # Shape: (n_prototypes,)\\n",
    "            \\n",
    "            # Convert to numpy if needed\\n",
    "            if isinstance(prototypes, torch.Tensor):\\n",
    "                prototypes = prototypes.numpy()\\n",
    "            if isinstance(labels_proto, torch.Tensor):\\n",
    "                labels_proto = labels_proto.numpy()\\n",
    "            \\n",
    "            # Compute distances to all prototypes\\n",
    "            feat_np = feat.numpy().reshape(1, -1)\\n",
    "            distances = np.linalg.norm(feat_np - prototypes, axis=1)\\n",
    "            \\n",
    "            # Find closest prototype\\n",
    "            closest_idx = np.argmin(distances)\\n",
    "            pred = int(labels_proto[closest_idx])\\n",
    "            \\n",
    "            # Compute probabilities based on distances (inverse distance weighting)\\n",
    "            inv_distances = 1.0 / (distances + 1e-8)  # Add small epsilon to avoid division by zero\\n",
    "            proba_raw = np.zeros(2)\\n",
    "            for i, label in enumerate(labels_proto):\\n",
    "                proba_raw[int(label)] += inv_distances[i]\\n",
    "            \\n",
    "            # Normalize to get probabilities\\n",
    "            proba = proba_raw / proba_raw.sum() if proba_raw.sum() > 0 else np.array([0.5, 0.5])\\n",
    "            \\n",
    "            return pred, proba\\n",
    "        else:\\n",
    "            raise ValueError(f'Protonet model dict missing required keys: {model.keys()}')\\n",
    "    else:\\n",
    "        X = feat.numpy().reshape(1, -1)\\n",
    "        pred = int(model.predict(X)[0])\\n",
    "        try:\\n",
    "            proba = model.predict_proba(X)[0]\\n",
    "        except Exception:\\n",
    "            proba = None\\n",
    "        return pred, proba\\n",
    "\\n",
    "print('✅ Prediction function defined')"
   ]
  }
,
