    "# ============================================================\\n",
    "# CELL 3 — Model Configurations\\n",
    "# ============================================================\\n",
    "\\n",
    "# Define Base Dimensions for each model\\n",
    "MODEL_BASE_DIMS = {\\n",
    "    'Conch1_5': 2048,\\n",
    "    'H-Optimus-1': 4096,\\n",
    "    'UNI2': 4096,\\n",
    "}\\n",
    "\\n",
    "# Aggregation method multipliers (for FiveCrop)\\n",
    "AGG_MULTIPLIERS = {\\n",
    "    'Caption_based_aggregation': 5.25,  # 5 crops + 0.25 for caption\\n",
    "    'Tissue_Type_Clustering': 1,\\n",
    "    'Averaging': 1,\\n",
    "    'TITAN': 1,\\n",
    "}\\n",
    "\\n",
    "# Calculate input dimension automatically\\n",
    "if MODEL_NAME == 'TITAN':\\n",
    "    INPUT_DIM = 768\\n",
    "else:\\n",
    "    base = MODEL_BASE_DIMS.get(MODEL_NAME, 2048)\\n",
    "    mult = AGG_MULTIPLIERS.get(AGGREGATION_METHOD, 1)\\n",
    "    INPUT_DIM = int(base * mult)\\n",
    "\\n",
    "# PAIP feature folder mapping\\n",
    "PAIP_FEATURE_DIRS = {\\n",
    "    'Conch1_5': 'conch_CC_fivecrop',\\n",
    "    'H-Optimus-1': 'hoptimus_CC_fivecrop',\\n",
    "    'UNI2': 'uni2_CC_fivecrop',\\n",
    "}\\n",
    "\\n",
    "# All folds to evaluate\\n",
    "FOLDS = [0, 1, 2, 3]\\n",
    "\\n",
    "# Classifier filename templates\\n",
    "CLASSIFIER_TEMPLATES = {\\n",
    "    'logistic_regression': 'fold{fold}_logistic_regression.pkl',\\n",
    "    'knn': 'fold{fold}_knn_model.pkl',\\n",
    "    'protonet': 'fold{fold}_protonet_model.pkl',\\n",
    "    'random_forest': 'fold{fold}_random_forest_model.pkl',\\n",
    "    'ann': 'fold{fold}_trained_ann_model_{input_dim}.pth',\\n",
    "}\\n",
    "\\n",
    "# Classifiers to evaluate (comment out any you don't want to run)\\n",
    "CLASSIFIERS_TO_RUN = [\\n",
    "    'logistic_regression',\\n",
    "    'knn',\\n",
    "    'protonet',\\n",
    "    'random_forest',\\n",
    "    'ann',\\n",
