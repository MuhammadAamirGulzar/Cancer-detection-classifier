    "import pandas as pd\\n",
    "import numpy as np\\n",
    "import joblib\\n",
    "import warnings\\n",
    "from sklearn.metrics import (\\n",
    "    accuracy_score,\\n",
    "    balanced_accuracy_score,\\n",
    "    f1_score,\\n",
    "    roc_auc_score,\\n",
    "    confusion_matrix,\\n",
    ")\\n",
    "from typing import Dict, List, Tuple, Optional\\n",
    "\\n",
    "warnings.filterwarnings('ignore')\\n",
    "print('✅ Imports OK')"
   ]
