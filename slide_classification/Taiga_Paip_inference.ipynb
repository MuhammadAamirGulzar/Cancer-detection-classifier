   "source": [
    "# ============================================================\\n",
    "# CELL 8 — Metrics Helper\\n",
    "# ============================================================\\n",
    "def compute_metrics(y_true: np.ndarray,\\n",
    "                    y_pred: np.ndarray,\\n",
    "                    y_proba: Optional[np.ndarray]) -> Dict:\\n",
    "    '''\\n",
    "    Compute full classification metrics including:\\n",
    "    Accuracy, Balanced Accuracy, F1, AUROC,\\n",
    "    Sensitivity, Specificity, PPV, NPV, TP/TN/FP/FN\\n",
    "    '''\\n",
    "    cm = confusion_matrix(y_true, y_pred, labels=[0, 1])\\n",
    "    tn, fp, fn, tp = cm.ravel()\\n",
    "\\n",
    "    sensitivity = tp / (tp + fn) if (tp + fn) > 0 else 0.0\\n",
    "    specificity = tn / (tn + fp) if (tn + fp) > 0 else 0.0\\n",
    "    ppv = tp / (tp + fp) if (tp + fp) > 0 else 0.0\\n",
    "    npv = tn / (tn + fn) if (tn + fn) > 0 else 0.0\\n",
    "\\n",
    "    metrics = {\\n",
    "        'accuracy': accuracy_score(y_true, y_pred),\\n",
    "        'balanced_accuracy': balanced_accuracy_score(y_true, y_pred),\\n",
    "        'f1_macro': f1_score(y_true, y_pred, average='macro'),\\n",
    "        'f1_weighted': f1_score(y_true, y_pred, average='weighted'),\\n",
    "        'sensitivity': sensitivity,\\n",
    "        'specificity': specificity,\\n",
    "        'ppv': ppv,\\n",
    "        'npv': npv,\\n",
    "        'tp': int(tp), 'tn': int(tn), 'fp': int(fp), 'fn': int(fn),\\n",
    "        'confusion_matrix': cm.tolist(),\\n",
    "        'auroc': None,\\n",
    "    }\\n",
    "\\n",
    "    if y_proba is not None and len(np.unique(y_true)) == 2:\\n",
    "        try:\\n",
    "            pos = y_proba[:, 1] if y_proba.ndim == 2 else y_proba\\n",
    "            metrics['auroc'] = roc_auc_score(y_true, pos)\\n",
    "        except Exception:\\n",
    "            pass\\n",
    "\\n",
    "    return metrics\\n",
    "\\n",
    "print('✅ Metrics helper defined')"
   ]
  }
,
