    "# ============================================================\\n",
    "# CELL 4 — ANN Model Architecture\\n",
    "# ============================================================\\n",
    "class ANNClassifier(nn.Module):\\n",
    "    '''Must match the architecture used during TCGA training.'''\\n",
    "    def __init__(self, input_dim: int, hidden_dim: int = 512,\\n",
    "                 hidden_dim2: int = 256, num_classes: int = 2):\\n",
    "        super().__init__()\\n",
    "        self.model = nn.Sequential(\\n",
    "            nn.Linear(input_dim, hidden_dim),\\n",
    "            nn.ReLU(),\\n",
    "            nn.BatchNorm1d(hidden_dim),\\n",
    "            nn.Dropout(0.3),\\n",
    "            nn.Linear(hidden_dim, hidden_dim2),\\n",
    "            nn.ReLU(),\\n",
    "            nn.BatchNorm1d(hidden_dim2),\\n",
    "            nn.Dropout(0.3),\\n",
    "            nn.Linear(hidden_dim2, num_classes),\\n",
    "            nn.Softmax(dim=1)\\n",
    "        )\\n",
    "\\n",
    "    def forward(self, x: torch.Tensor) -> torch.Tensor:\\n",
    "        return self.model(x)\\n",
    "\\n",
    "print('✅ ANNClassifier defined')"
   ]
  }
,
