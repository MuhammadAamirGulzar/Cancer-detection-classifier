   "outputs": [],
   "source": [
    "# ============================================================\\n",
    "# CELL 5 — Label & Ground Truth Helpers\\n",
    "# ============================================================\\n",
    "def parse_label(raw) -> Optional[int]:\\n",
    "    '''\\n",
    "    Convert any label string/int to binary.\\n",
    "      nonMSIH / 0 / mss  →  0\\n",
    "      MSIH    / 1 / msi  →  1\\n",
    "    '''\\n",
    "    if raw is None:\\n",
    "        return None\\n",
    "    s = str(raw).strip().lower()\\n",
    "    if s in ('0', 'nonmsih', 'non-msih', 'mss'):\\n",
    "        return 0\\n",
    "    if s in ('1', 'msih', 'msi-h', 'msih_c', 'msi'):\\n",
    "        return 1\\n",
    "    try:\\n",
    "        return int(float(s))\\n",
    "    except ValueError:\\n",
    "        return None\\n",
    "\\n",
    "\\n",
    "def load_ground_truth(csv_path: str) -> pd.DataFrame:\\n",
    "    '''Load CSV and add normalised _wsi_id and _bin_label columns.'''\\n",
    "    df = pd.read_csv(csv_path)\\n",
    "    df.columns = [c.strip() for c in df.columns]\\n",
    "    print(f'Ground truth: {len(df)} rows | columns: {df.columns.tolist()}')\\n",
    "    print(df.head(3).to_string(), '\\n')\\n",
    "\\n",
    "    # Identify WSI id column\\n",
    "    id_col = 'WSI_Id' if 'WSI_Id' in df.columns else df.columns[0]\\n",
    "\\n",
    "    # Identify label column\\n",
    "    lbl_col = None\\n",
    "    for cand in ('label', 'label_desc', 'Label', 'MSI_status'):\\n",
    "        if cand in df.columns:\\n",
    "            lbl_col = cand\\n",
    "            break\\n",
    "    if lbl_col is None:\\n",
    "        raise ValueError(f'No label column found in {df.columns.tolist()}')\\n",
    "\\n",
    "    df['_wsi_id'] = df[id_col].astype(str).str.strip()\\n",
    "    df['_bin_label'] = df[lbl_col].apply(parse_label)\\n",
    "\\n",
    "    bad = df['_bin_label'].isna().sum()\\n",
    "    if bad:\\n",
    "        print(f'⚠️  {bad} rows with unparseable labels — will be skipped')\\n",
    "\\n",
    "    return df\\n",
    "\\n",
    "\\n",
    "def get_label(wsi_id: str, gt_df: pd.DataFrame) -> Optional[int]:\\n",
    "    '''\\n",
    "    Look up binary label for a WSI id with three fallback strategies:\\n",
    "      1. Exact match on _wsi_id\\n",
    "      2. Partial / substring match\\n",
    "      3. Extract MSIH / nonMSIH directly from the filename stem\\n",
    "    '''\\n",
    "    # Strategy 1 — exact\\n",
    "    row = gt_df[gt_df['_wsi_id'] == wsi_id]\\n",
    "    if not row.empty:\\n",
    "        return row['_bin_label'].values[0]\\n",
    "\\n",
    "    # Strategy 2 — substring\\n",
    "    for _, r in gt_df.iterrows():\\n",
    "        if r['_wsi_id'] in wsi_id or wsi_id in r['_wsi_id']:\\n",
    "            return r['_bin_label']\\n",
    "\\n",
    "    # Strategy 3 — parse from filename\\n",
    "    lower = wsi_id.lower()\\n",
    "    if '_nonmsih' in lower:\\n",
    "        return 0\\n",
    "    if '_msih' in lower:\\n",
    "        return 1\\n",
    "\\n",
    "    return None\\n",
    "\\n",
    "print('✅ Label helpers defined')"
   ]
  }
,
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\\n",
    "# CELL 6 — Feature Loading & Model Loading Helpers\\n",
    "# ============================================================\\n",
    "def load_features(feature_dir: str) -> Tuple[Dict[str, torch.Tensor], List[str]]:\\n",
    "    '''Load all .pt files from a directory. Flattens multi-dim tensors.'''\\n",
    "    features_dict: Dict[str, torch.Tensor] = {}\\n",
    "    wsi_ids: List[str] = []\\n",
    "\\n",
    "    if not os.path.isdir(feature_dir):\\n",
    "        print(f'  ❌  Directory not found: {feature_dir}')\\n",
    "        return features_dict, wsi_ids\\n",
    "\\n",
    "    files = [f for f in os.listdir(feature_dir) if f.endswith('.pt')]\\n",
    "    print(f'  Found {len(files)} .pt files in: {os.path.basename(feature_dir)}')\\n",
    "\\n",
    "    for fname in files:\\n",
    "        wsi_id = os.path.splitext(fname)[0]\\n",
    "        try:\\n",
    "            feat = torch.load(os.path.join(feature_dir, fname), map_location='cpu')\\n",
    "            if feat.dim() > 1:\\n",
    "                feat = feat.flatten()   # (N_crops, D) → (N_crops * D,)\\n",
    "            features_dict[wsi_id] = feat.float()\\n",
    "            wsi_ids.append(wsi_id)\\n",
    "        except Exception as e:\\n",
    "            print(f'  ⚠️  Could not load {fname}: {e}')\\n",
    "\\n",
    "    return features_dict, wsi_ids\\n",
    "\\n",
    "\\n",
    "def load_model(classifier_name: str, model_path: str, input_dim: int):\\n",
    "    '''Load either a sklearn (.pkl) or PyTorch ANN (.pth) model.'''\\n",
    "    if classifier_name == 'ann':\\n",
    "        m = ANNClassifier(input_dim)\\n",
    "        state = torch.load(model_path, map_location='cpu')\\n",
    "        # Handle both raw state_dict and wrapped checkpoints\\n",
    "        if isinstance(state, dict) and 'model_state_dict' in state:\\n",
    "            state = state['model_state_dict']\\n",
    "        m.model.load_state_dict(state)\\n",
    "        m.eval()\\n",
    "        return m\\n",
    "    else:\\n",
    "        loaded = joblib.load(model_path)\\n",
    "        # Handle protonet/random_forest checkpoint dict format\\n",
    "        if isinstance(loaded, dict):\\n",
    "            if 'model' in loaded:\\n",
    "                return loaded['model']\\n",
    "            elif 'classifier' in loaded:\\n",
    "                return loaded['classifier']\\n",
    "            elif 'prototypes' in loaded and 'labels_proto' in loaded:\\n",
    "                # This is a protonet model saved as dict - return the dict itself\\n",
    "                # We'll handle this special case in the predict function\\n",
    "                return loaded\\n",
    "        return loaded\\n",
    "\\n",
    "print('✅ Feature & model helpers defined')"
   ]
  }
,
